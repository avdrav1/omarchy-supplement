# BlueFerry local settings -- seeded to ~/.config/blueferry/local.env by
# install-blueferry.sh when that file is absent, and owned by BlueFerry
# thereafter. This tracked copy is the reference; the live one is not.
#
# THREE THINGS TO KNOW BEFORE EDITING THE LIVE FILE:
#
#   1. Every comment below is lost the first time you pair, or change the ANCS
#      toggle in a client. pair_setup.write_local_env() re-serializes the file
#      from parsed key=value pairs only (`config.LOCAL_ENV_KEYS` order), so
#      comments and commented-out examples never survive. Values for the keys
#      below DO survive -- they are read back and re-emitted -- which is why
#      seeding them here is worth doing at all.
#   2. It must be a real 0600 file in a 0700 directory. BlueFerry reads it with
#      O_NOFOLLOW via private_files.read_private_text(), so a symlink (what GNU
#      Stow would create) fails with ELOOP, is swallowed by read_local_env()'s
#      `except OSError: return {}`, and every setting here silently reverts to
#      its built-in default. Hence: seeded, never stowed.
#   3. Its mere existence is what lets the daemon start at login --
#      blueferry.service carries ConditionPathExists=%h/.config/blueferry/local.env.
#      Deleting it does not just reset settings; it disables the unit.
#
# The daemon parses this file itself at import time; systemd deliberately does
# not source it. Restart after editing:  systemctl --user restart blueferry
#
# BLUEFERRY_MAC / BLUEFERRY_ADAPTER / BLUEFERRY_ANCS_ENABLED are written by
# pairing and are deliberately absent here -- they are per-machine, per-phone,
# and a stale MAC copied between machines points the daemon at a phone that
# will never appear.

# Show message text in the desktop popup. Upstream's default is true; set false
# to get sender-only notifications on a screen other people can see.
BLUEFERRY_SHOW_NOTIFICATION_CONTENT=true

# Popup lifetime in ms (bounds 1000-60000).
BLUEFERRY_NOTIFICATION_TIMEOUT_MS=8000

# Encrypted local history: age, count, and on-disk size caps (bounds
# 1-3650 days, 100-1000000 events, 16MiB-2GiB). These are the upstream
# defaults, written out explicitly so a change here is visible in git rather
# than being a silent drift from whatever the installed version defaults to.
BLUEFERRY_HISTORY_RETENTION_DAYS=30
BLUEFERRY_HISTORY_MAX_EVENTS=10000
BLUEFERRY_HISTORY_MAX_PAYLOAD_BYTES=268435456

# Only consulted when a client selects "All iPhone Notifications" -- exact,
# case-sensitive ANCS bundle IDs. Blocklist wins over allowlist; an explicitly
# empty allowlist blocks every non-Messages app. Discover IDs with:
#   journalctl --user -u blueferry -f | grep "ANCS app observed"
# BLUEFERRY_ANCS_APP_BLOCKLIST=com.example.Chat,com.example.Mail
# BLUEFERRY_ANCS_APP_ALLOWLIST=com.example.Calendar,com.example.Reminders
